#!/bin/bash
# zaatar - single entry point (installed on PATH by the Homebrew formula).
set -euo pipefail

BIN_DIR="$(cd "$(dirname "$0")" && pwd)"

usage() {
  cat <<USAGE
zaatar - local-first meeting recorder and transcriber

Usage:
  zaatar setup                interactive setup (LLM, calendar, models, apps)
  zaatar start [name]         start recording
  zaatar stop [--fast]        stop recording (transcription runs in background)
  zaatar status               show recorder status
  zaatar transcribe <wav>     (re)transcribe a recording
  zaatar analyze <wav|last>   run full emotional/behavioral eval on a recording
  zaatar brief --title T --attendees "a@x,b@y"   generate a pre-meeting brief
  zaatar help                 this text

Config: ~/.config/zaatar/config (see 'zaatar setup')
USAGE
}

case "${1:-help}" in
  setup)      exec "$BIN_DIR/../scripts/setup.sh" ;;
  start)      shift; exec "$BIN_DIR/rec" start "$@" ;;
  stop)       shift; exec "$BIN_DIR/rec" stop "$@" ;;
  status)     exec "$BIN_DIR/rec" status ;;
  transcribe) shift; exec "$BIN_DIR/transcribe.sh" "$@" ;;
  analyze)
    shift; ARG="${1:-}"
    if [ "$ARG" = "last" ]; then
      . "$BIN_DIR/../lib/config.sh"
      ARG="$(ls -t "$ZAATAR_REC_DIR"/*.wav 2>/dev/null | head -1)"
      [ -z "$ARG" ] && { echo "No recordings found in $ZAATAR_REC_DIR"; exit 1; }
    fi
    exec "$BIN_DIR/analyze.sh" "$ARG" ;;
  brief)      shift; exec "$BIN_DIR/brief.sh" "$@" ;;
  help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
